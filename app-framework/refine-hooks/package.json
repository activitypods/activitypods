{
  "name": "@activitypods/refine-hooks",
  "version": "2.3.2",
  "type": "module",
  "description": "React hooks for ActivityPods apps built with Refine",
  "license": "Apache-2.0",
  "author": "Virtual Assembly",
  "homepage": "https://activitypods.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/assemblee-virtuelle/activitypods.git",
    "directory": "app-framework/refine-hooks"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "targets": {
    "index": {
      "source": "src/index.ts",
      "distDir": "dist",
      "context": "browser",
      "outputFormat": "esmodule",
      "isLibrary": true,
      "includeNodeModules": false,
      "sourceMap": true
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist .parcel-cache && parcel build && tsc -p tsconfig.build.json && yalc publish --push --changed",
    "watch": "concurrently -n parcel,tsc -c blue,yellow \"parcel watch --no-cache\" \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@activitypods/refine-providers": "2.3.2"
  },
  "peerDependencies": {
    "@refinedev/core": "^5.0.12",
    "@tanstack/react-query": "^5.81.5",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@refinedev/core": "^5.0.12",
    "@tanstack/react-query": "^5.81.5",
    "@types/react": "^19.1.0",
    "concurrently": "^10.0.3",
    "react": "^19.1.0",
    "typescript": "^5.8.3",
    "yalc": "^1.0.0-pre.53"
  }
}
