{
  "scripts": {
    "prettier": "prettier --write '**/*.{js,ts,json,tsx,jsx}'",
    "preinstall": "git config core.hooksPath config/git-hooks",
    "lint": "eslint .",
    "lint-files": "eslint",
    "typecheck": "tsc --noEmit",
    "dev:bootstrap-all": "sh ./scripts/bootstrap-local-dev.sh",
    "dev:shutdown-all": "sh ./scripts/shutdown-local-dev.sh",
    "dev:status-all": "sh ./scripts/status-local-dev.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "@types/eslint__eslintrc": "^2.1.1",
    "@typescript-eslint/parser": "7.10.0",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import-typescript": "^0.0.4",
    "eslint-plugin-import-x": "^0.5.1",
    "eslint-plugin-jest": "^28.5.0",
    "eslint-plugin-jsdoc": "^48.2.6",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.3.0",
    "prettier": "^3.2.5",
    "typescript": "^5.2.2",
    "typescript-eslint": "^7.10.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "pnpm": {
    "overrides": {
      "@astrojs/sitemap": "3.0.5",
      "sitemap": "7.1.1"
    }
  }
