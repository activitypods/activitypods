    "proof:atproto:migration:dry-run": "node scripts/proof-atproto-migration-dry-run.js",
    "proof:atproto:migration:repo": "node scripts/proof-atproto-migration-repo.js",
    "proof:atproto:migration:full": "node scripts/proof-atproto-migration-full.js",
